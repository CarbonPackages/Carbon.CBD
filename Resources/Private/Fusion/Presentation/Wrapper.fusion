prototype(Carbon.CBD:Presentation.Wrapper) < prototype(Neos.Fusion:Component) {
    // Is is possible to edit the element (renderingMode.isEdit)
    editable = false

    // Add here you live view
    // You can use Carbon.CBD:ChildContentRenderer here to render child nodes
    // Carbon.CBD:ChildContentRenderer iterates through child nodes and disables content element wrapping
    live = null

    // Add here your edit view
    // Most of the times you can use Carbon.CBD:ContentCollectionRenderer here
    // The content collection need to have the attribute data-__cbd-content-collection
    edit = null

    renderer = Neos.Fusion:Join {
        editMode = Neos.Fusion:Tag {
            @if.render = ${props.editable}
            attributes.data-__cbd-mode = ${props.live ? 'live' : 'edit'}
            content = Neos.Fusion:Join {
                edit = Neos.Fusion:Augmenter {
                    data-__cbd-edit = true
                    content = ${props.edit}
                }
                live = ${props.live}
            }
        }
        frontendView = ${props.live}
        frontendView.@if.render = ${!props.editable && props.live}
    }
}
