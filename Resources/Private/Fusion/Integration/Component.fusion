prototype(Carbon.CBD:Component) < prototype(Neos.Neos:ContentComponent) {
    editable = ${renderingMode.isEdit}
    live = Carbon.CBD:ChildContentRenderer
    edit = Carbon.CBD:ContentCollectionRenderer

    renderer = Carbon.CBD:Presentation.Wrapper {
        editable = ${props.editable}
        live = ${props.live}
        edit = ${props.edit}
    }

   @cache {
        mode = 'cached'
        maximumLifetime = ${q(node).context({'invisibleContentShown': true}).add(q(node).children()).cacheLifetime()}
        entryIdentifier {
            node = ${Neos.Caching.entryIdentifierForNode(node)}
            editPreviewMode = ${renderingMode.name}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(node)}
            2 = ${Neos.Caching.descendantOfTag(node)}
        }
    }

    @exceptionHandler = 'Neos\\Neos\\Fusion\\ExceptionHandlers\\NodeWrappingHandler'
}
