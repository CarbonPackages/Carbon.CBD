  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/CarbonPackages/Carbon.CBD.git"
  },
  "private": true,
  "scripts": {
    "css": "lightningcss --minify --bundle Resources/Private/NeosUI/Plugin.css -o Resources/Public/Plugin.css",
