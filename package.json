    "dev": "pnpm css && node build.mjs --dev",
    "pipeline": "pnpm install --silent;pnpm build"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@neos-project/neos-ui-extensibility": "~8.4.4",
    "@neos-project/react-ui-components": "~8.4.4",
